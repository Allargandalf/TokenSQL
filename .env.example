# Copy to .env only on the server. Never commit real keys or provider credentials.
TOKENSQL_WORKSPACE_DIR=./var/workspace
TOKENSQL_AGENT_DIR=../TokenSQL-opencode
TOKENSQL_INPUT_DIR=./input
TOKENSQL_PROGRESS_DIR=./progress
TOKENSQL_DATA_DIR=./data
TOKENSQL_OPENCODE_URL=http://127.0.0.1:8766
TOKENSQL_OPENCODE_PROVIDER=qwen38-flash-next-local
TOKENSQL_OPENCODE_MODEL=qwen3.8-flash-next-iq3_s
TOKENSQL_OPENCODE_TIMEOUT_SECONDS=900
# Real executable, not a wrapper that changes the shared coding environment.
# TOKENSQL_OPENCODE_BIN=/absolute/path/to/opencode
# Reuse ONLY the selected provider entry from this JSON.
# TOKENSQL_OPENCODE_CONFIG=/absolute/path/to/provider/opencode.json
TOKENSQL_FX_AUTO_REFRESH=true
TOKENSQL_FX_REFRESH_SECONDS=3600
TOKENSQL_WORKSPACE_MAX_FILE_MB=20
TOKENSQL_WORKSPACE_MAX_TOTAL_MB=80
TOKENSQL_WORKSPACE_MAX_FILES=20
