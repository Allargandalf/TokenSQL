# Copy to .env and replace every angle-bracketed value before deployment.
# Do not commit .env.

# New quote grid + OpenCode chat; independent from the legacy database.
# Pass --opencode-bin and --provider-config or export their runtime env vars.
TOKENSQL_WORKSPACE_DIR=./var/workspace
TOKENSQL_OPENCODE_URL=http://127.0.0.1:8766
TOKENSQL_OPENCODE_PROVIDER=qwen38-flash-next-local
TOKENSQL_OPENCODE_MODEL=qwen3.8-flash-next-iq3_s
TOKENSQL_OPENCODE_TIMEOUT_SECONDS=900
TOKENSQL_WORKSPACE_MAX_FILE_MB=20
TOKENSQL_WORKSPACE_MAX_TOTAL_MB=80
TOKENSQL_WORKSPACE_MAX_FILES=20

# SQLite MVP default. Four slashes mean the absolute container path /data/tokensql.db.
TOKENSQL_DATABASE_URL=sqlite+pysqlite:////data/tokensql.db
TOKENSQL_DATABASE_ECHO=false
TOKENSQL_SQLITE_BUSY_TIMEOUT_MS=5000

# Qwen is opt-in. Semantic import defaults below match src/tokensql/config.py.
# The base URL is the shared OpenAI-compatible gateway; verify it is live and
# loopback-only unless you explicitly allow remote. Never commit real keys.
TOKENSQL_QWEN_ENABLED=false
TOKENSQL_QWEN_BASE_URL=http://127.0.0.1:8080/v1
TOKENSQL_QWEN_MODEL=
TOKENSQL_QWEN_API_KEY=<optional-local-token>
TOKENSQL_QWEN_TIMEOUT_SECONDS=30
TOKENSQL_QWEN_ALLOW_REMOTE=false
# Process-wide in-flight budget shared per base URL (1-8).
TOKENSQL_QWEN_MAX_IN_FLIGHT=1
# Max completion tokens per request (256-32768).
TOKENSQL_QWEN_MAX_TOKENS=8192
# One of: none, low, medium, high.
TOKENSQL_QWEN_REASONING_EFFORT=low
# Auto-publish threshold; applies to row and model_name/components confidence.
TOKENSQL_QWEN_AUTO_PUBLISH_MIN_CONFIDENCE=0.85
# Legacy deterministic-path candidate matching threshold.
TOKENSQL_QWEN_MIN_CONFIDENCE=0.75
# Prompt/extraction version markers recorded in import context and audits.
TOKENSQL_QWEN_EXTRACTION_VERSION=qwen-extract-v3
TOKENSQL_QWEN_TABLE_PROMPT_VERSION=qwen-table-v2

# Loopback port publishing for Docker Compose.
TOKENSQL_API_PORT=8000
TOKENSQL_UI_PORT=8501
TOKENSQL_POSTGRES_PORT=5432

# Used only with the optional "postgres" Compose profile.
POSTGRES_DB=tokensql
POSTGRES_USER=tokensql
POSTGRES_PASSWORD=<set-a-strong-password>
