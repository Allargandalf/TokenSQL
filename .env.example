# Optional workspace configuration. Do not commit a real .env or provider keys.

# File + Prompt -> isolated OpenCode -> transactional quote store.
# Pass --opencode-bin and --provider-config or export their runtime env vars.
TOKENSQL_WORKSPACE_DIR=./var/workspace
TOKENSQL_OPENCODE_URL=http://127.0.0.1:8766
TOKENSQL_OPENCODE_PROVIDER=qwen38-flash-next-local
TOKENSQL_OPENCODE_MODEL=qwen3.8-flash-next-iq3_s
TOKENSQL_OPENCODE_TIMEOUT_SECONDS=900
TOKENSQL_WORKSPACE_MAX_FILE_MB=20
TOKENSQL_WORKSPACE_MAX_TOTAL_MB=80
TOKENSQL_WORKSPACE_MAX_FILES=20
